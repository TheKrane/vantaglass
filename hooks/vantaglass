#!/usr/bin/env bash
# Vantaglass managed hook; no downloads, privileges, or theme changes.
manager="$HOME/.local/share/vantaglass/runtime/tools/manage.py"
case "$0" in
    */post-boot.d/*)
        python "$manager" sync --hook
        exec python "$manager" entertainment start
        ;;
    *)
        exec python "$manager" sync --hook
        ;;
esac
